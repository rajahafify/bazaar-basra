# Cloudflare Pages headers. Built assets have content hashes in their names, so they can be cached for good;
# the page itself is always revalidated so a new build reaches players on their next open.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
